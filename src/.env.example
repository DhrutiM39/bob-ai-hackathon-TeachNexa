# Copy this file to .env and fill in your actual values
# NEVER commit the .env file — it is in .gitignore

# ── DeepSeek AI ─────────────────────────────────────────────────────────────
# Get your key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Optional — override the model (default: deepseek-chat)
# DEEPSEEK_MODEL=deepseek-chat

# ── PostgreSQL Database ─────────────────────────────────────────────────────
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://coursegenie:changeme@localhost:5432/coursegenie

# ── Application ─────────────────────────────────────────────────────────────
APP_PORT=8000
APP_ENV=development          # set to "production" in prod

# ── Frontend ────────────────────────────────────────────────────────────────
# Base URL the frontend Vite dev server proxies API calls to (default: empty = same origin)
# VITE_API_BASE_URL=http://localhost:8000
# Demo owner UUID — seed this user in the DB first (see docs/setup-guide.md)
VITE_DEMO_OWNER_ID=00000000-0000-0000-0000-000000000001

# ── Notifications (optional) ────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
