VITE_API_BASE_URL=http://localhost:8000

# Set to "true" in .env.local only during local UI development without a backend.
# Default is "false" — the real API is always used in production and CI.
VITE_USE_MOCKS=false
# Demo owner UUID — must exist in the users table (see docs/setup-guide.md § "Seed a demo user")
VITE_DEMO_OWNER_ID=00000000-0000-0000-0000-000000000001
